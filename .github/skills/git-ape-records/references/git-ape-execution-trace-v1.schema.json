{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.github.io/git-ape/schemas/git-ape-execution-trace-v1.schema.json",
  "title": "Git-Ape Execution Trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "traceId", "invocationId", "workflow", "producer", "graph", "startedAt", "endedAt", "outcome", "events"],
  "properties": {
    "schemaVersion": {"const": "git-ape-execution-trace/v1"},
    "traceId": {"type": "string", "minLength": 1},
    "invocationId": {"type": "string", "minLength": 1},
    "workflow": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity"],
      "properties": {
        "type": {"enum": ["workflow", "agent-observed"]},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "startedAt": {"type": "string", "minLength": 1},
    "endedAt": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["succeeded", "failed"]},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "recordedAt", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["node", "transition"]},
          "recordedAt": {"type": "string", "minLength": 1},
          "node": {"type": "string", "minLength": 1},
          "status": {"enum": ["completed", "failed"]},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "result": {"type": ["string", "null"]}
        }
      }
    }
  }
}
