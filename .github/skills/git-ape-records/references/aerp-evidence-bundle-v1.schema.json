{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerp.dev/schema/aerp-evidence-bundle-v1.schema.json",
  "title": "AERP Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "producer",
    "subject",
    "records",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "aerp-evidence-bundle/v1" },
    "bundle_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "identity", "invocation_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "invocation_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uri": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "digest": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "aerp-evidence-record-v1.schema.json"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_fingerprint"],
      "properties": {
        "bundle_fingerprint": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        }
      }
    }
  }
}
