{
  "type": "excalidraw",
  "version": 2,
  "source": "claude",
  "elements": [
    {
      "type": "text",
      "id": "title",
      "x": 40,
      "y": 20,
      "width": 900,
      "height": 70,
      "text": "Git-Ape + ISEE: portable records first, optional governance later",
      "fontSize": 28,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "native-container",
      "x": 30,
      "y": 100,
      "width": 940,
      "height": 270,
      "strokeColor": "#0078D4",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 }
    },
    {
      "type": "text",
      "id": "native-label",
      "x": 50,
      "y": 110,
      "width": 350,
      "height": 45,
      "text": "Native Git-Ape (no new dependency)",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
